{
  "name": "network-inspector",
  "version": "1.0.0",
  "description": "A desktop Chrome DevTools Protocol network inspector built with Electron.",
  "main": "apps/desktop/src/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build:renderer": "vite build --config vite.config.ts",
    "mcp:stdio": "node services/mcp/stdio.mjs",
    "mcp:http": "node services/mcp/http.mjs",
    "test:mcp": "node --test test/*.test.js test/*.test.mjs",
    "start": "pnpm run build:renderer && electron .",
    "dev": "pnpm run build:renderer && electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-remote-interface": "^0.33.3",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.example.networkinspector",
    "productName": "Network Inspector",
    "files": [
      "apps/desktop/src/**/*",
      "apps/desktop/dist/**/*",
      "apps/desktop/assets/**/*",
      "services/mcp/**/*",
      "packages/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "apps/desktop/assets"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
