{
  "manifest_version": 3,
  "name": "Website Analytics for Network Watch",
  "version": "0.1.0",
  "description": "Record and replay website journeys, simulate responsive breakpoints, and send annotated screenshots to Network Watch.",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:9231/*",
    "http://localhost:9231/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Website Analytics",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
